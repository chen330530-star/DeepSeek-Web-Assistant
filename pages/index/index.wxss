page {
  background-color: #f5f5f5;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* 聊天记录区 */
.chat-box {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.msg-row {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.row-user {
  flex-direction: row-reverse;
}

.row-ai {
  flex-direction: row;
}

/* 头像 */
.avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 10rpx;
  text-align: center;
  line-height: 70rpx;
  font-size: 24rpx;
  color: #fff;
  margin: 0 15rpx;
}
.avatar.user { background-color: #07c160; }
.avatar.ai { background-color: #1a1a1a; }

/* 聊天气泡 */
.bubble {
  max-width: 70%;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-wrap: break-word;
}

.bubble.user {
  background-color: #95ec69;
  color: #000;
  border-top-right-radius: 0;
}

.bubble.ai {
  background-color: #fff;
  color: #333;
  border-top-left-radius: 0;
}

/* 底部输入区 */
.input-area {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #e5e5e5;
  padding-bottom: env(safe-area-inset-bottom);
}

.input-box {
  flex: 1;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 15rpx 30rpx;
  font-size: 30rpx;
  margin-right: 20rpx;
}

.send-btn {
  width: 140rpx;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 40rpx;
  background-color: #07c160;
  color: #fff;
  font-size: 28rpx;
  padding: 0;
  margin: 0;
}
